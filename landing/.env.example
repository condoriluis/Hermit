# URL de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Base de datos de licencias)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreto

# PayPal (Pagos Internacionales)
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_SECRET=tu-paypal-secret
PAYPAL_MODE=sandbox # 'sandbox' para pruebas o 'live' para producción

# Pago por QR (Bolivia - BNB / BCP / Unión / Simple)
NEXT_PUBLIC_QR_MENSUAL_BOB=105
NEXT_PUBLIC_QR_ANUAL_BOB=1050
NEXT_PUBLIC_QR_IMG_URL=/qr-pago.png
NEXT_PUBLIC_WHATSAPP_SOPORTE=+591XXXXXXXX

